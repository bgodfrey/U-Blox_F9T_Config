[Unit]
Description=PANOSETI GNSS server
Documentation=file:{repo}/gnss_scripts/gnss_orchestrator_guide.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={repo}

# The orchestrator renders this from gnss_deployment.json5. Keep stdout/stderr
# in journald; server_v1.py owns the timestamped GNSS log/telemetry files.
ExecStart={exec_start}

Restart={restart}
RestartSec={restart_sec}

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
